{
  "sample_rate": 16000,
  "hotkey": {
    "windows": "ctrl_r",
    "darwin": "mouse_middle"
  },
  "whisper": {
    "windows": {
      "backend": "faster-whisper",
      "model_size": "small",
      "device": "cuda",
      "compute_type": "float16"
    },
    "darwin": {
      "backend": "mlx-whisper",
      "model_size": "small",
      "hf_repo": "mlx-community/whisper-small-mlx"
    }
  },
  "cleanup": {
    "backend": "local",
    "ollama_model": "llama3.2:3b",
    "ollama_url": "http://localhost:11434/api/generate"
  },
  "autostart": false,
  "theme": "dark",
  "opacity": "solid",
  "alwaysOnTop": true
}